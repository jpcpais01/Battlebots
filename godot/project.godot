; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Battlebots"
config/description="Auto 1v1 robot fighting."
run/main_scene="res://game/fight.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[debug]

gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/shadowed_global_identifier=0
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_local_constant=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_private_class_variable=0
gdscript/warnings/standalone_expression=0
gdscript/warnings/standalone_ternary=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/redundant_await=0
gdscript/warnings/confusable_local_declaration=0
gdscript/warnings/confusable_local_usage=0
gdscript/warnings/inference_on_variant=0
gdscript/warnings/static_called_on_instance=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2

[shader_globals]

bb_time={
"type": "float",
"value": 0.0
}
bb_hype={
"type": "float",
"value": 0.3
}
bb_flash={
"type": "float",
"value": 0.0
}
bb_house={
"type": "float",
"value": 0.6
}
bb_spot0={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
bb_spot1={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
bb_spot2={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
bb_fog_color={
"type": "vec3",
"value": Vector3(0.0021, 0.0031, 0.0062)
}
bb_fog_density={
"type": "float",
"value": 0.016
}
