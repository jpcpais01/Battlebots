; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Battlebots"
config/description="Auto 1v1 robot fighting."
run/main_scene="res://app/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
# Android's back button pauses the fight (ui/pause_menu.gd) instead of quitting
config/quit_on_go_back=false

[debug]

# the renderer stamps each render stage on the GPU's clock (and prints a summary to the log once
# a second): the performance overlay's live GPU rows read these (game/perf.gd)
settings/stdout/print_gpu_profile=true
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/shadowed_global_identifier=0
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_local_constant=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_private_class_variable=0
gdscript/warnings/standalone_expression=0
gdscript/warnings/standalone_ternary=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/redundant_await=0
gdscript/warnings/confusable_local_declaration=0
gdscript/warnings/confusable_local_usage=0
gdscript/warnings/inference_on_variant=0
gdscript/warnings/static_called_on_instance=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
# Swappy paces frames to the refresh rate the app started at (60 on most phones), which held the
# fight at 60 on 120 Hz screens; plain vsync runs at whatever rate game/display.gd asks for
window/frame_pacing/android/swappy_mode=0

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2

[shader_globals]

bb_surface_detail={
"type": "bool",
"value": true
}
bb_time={
"type": "float",
"value": 0.0
}
bb_hype={
"type": "float",
"value": 0.3
}
