uniform vec3 uDeep;
uniform vec3 uShallow;
uniform vec3 uZen;
uniform vec4 uWater;
float shoreDist(vec2 p) {
    vec2 q = (p - vec2(-60.0, 6.0)) / vec2(15.0, 11.0);
    return (1.0 - length(q)) * 11.0;
  }
float wh(vec2 p) {
        return texture(uNoise, p * 0.021 + vec2(uTime * 0.006, uTime * 0.0035)).g
             + texture(uNoise, p * 0.057 + vec2(-uTime * 0.011, uTime * 0.008)).r * 0.45;
