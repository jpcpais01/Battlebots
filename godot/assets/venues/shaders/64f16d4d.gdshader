        float foam = smoothstep(2.6, 0.2, abs(sd - 1.0 - wave * 0.9)) * (0.55 + 0.45 * texture(uNoise, vW.xz * 0.35 + t * 0.03).r);
        foam += smoothstep(0.8, 0.0, sd) * 0.6;
