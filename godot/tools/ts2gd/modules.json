  "overrides": {
    "src/patchNotes.ts:hourLabel": [
      "# (the web's Date and toLocale*String: the UTC hour in the phone's own time zone, as \"Oct 12 · 19:00\")",
      "if not RegEx.create_from_string(\"^\\\\d{4}-\\\\d{2}-\\\\d{2} \\\\d{2}:\\\\d{2}$\").search(hour):",
      "\treturn hour",
      "var t := Time.get_unix_time_from_datetime_string(hour.replace(\" \", \"T\") + \":00\")",
      "t += int(Time.get_time_zone_from_system().bias) * 60",
      "var d := Time.get_datetime_dict_from_unix_time(t)",
      "var months := [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"]",
      "return \"%s %d · %02d:%02d\" % [months[int(d.month) - 1], int(d.day), int(d.hour), int(d.minute)]"
    ],
    "src/sim/math.ts:Rng.next": [
      "# (mulberry32 in 64-bit ints rather than through JS.imul/bxor/ushr: the same 32-bit maths, no calls)",
      "self.s += float(1831565813)",
      "var t: int = int(s) & 0xFFFFFFFF",
      "var a: int = t ^ (t >> 15)",
      "var b: int = t | 1",
      "if a >= 0x80000000:",
      "\ta -= 0x100000000",
      "if b >= 0x80000000:",
      "\tb -= 0x100000000",
      "t = (a * b) & 0xFFFFFFFF",
      "a = t ^ (t >> 7)",
      "b = t | 61",
      "if a >= 0x80000000:",
      "\ta -= 0x100000000",
      "if b >= 0x80000000:",
      "\tb -= 0x100000000",
      "t = t ^ ((t + ((a * b) & 0xFFFFFFFF)) & 0xFFFFFFFF)",
      "return float(t ^ (t >> 14)) / float(4294967296)"
    ]
  }
}
